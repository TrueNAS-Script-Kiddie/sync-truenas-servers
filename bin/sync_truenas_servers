#!/usr/bin/bash
# bin/sync_truenas_servers

# Resolve paths
declare SCRIPT_FILENAME="$(basename "$0")"
declare SCRIPT_DIR
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)" \
    || { echo "ERROR: Failed to resolve SCRIPT_DIR"; exit 1; }
declare LOG_DIR="${SCRIPT_DIR}/../logs"

[[ ! -d "${LOG_DIR}" ]] && mkdir -p "${LOG_DIR}"

if [[ -f "${SCRIPT_DIR}/../config/config.local.bash" ]]; then
    # shellcheck source=config/config.example.bash
    source "${SCRIPT_DIR}/../config/config.local.bash"
else
    echo "ERROR: No config found. Expected config.local.bash in ../config"
    exit 1
fi

# Validate required config
: "${EMAIL_TO:?ERROR: EMAIL_TO must be set in config.local.bash}"
: "${SSH_CONFIG_FILE:?ERROR: SSH_CONFIG_FILE must be set in config.local.bash}"

# Derive host roles
declare LOCAL_SERVER_ID="$(hostname -s | sed 's/^truenas-//')"
if [[ "${LOCAL_SERVER_ID}" == "master" ]]; then
    declare REMOTE_SERVER_ID="backup"
elif [[ "${LOCAL_SERVER_ID}" == "backup" ]]; then
    declare REMOTE_SERVER_ID="master"
else
    echo "ERROR: The hostname ($(hostname -s)) is unknown. Run on truenas-master or truenas-backup."
    exit 1
fi

REMOTE_CMD=( ssh -F "${SSH_CONFIG_FILE}" "truenas-${REMOTE_SERVER_ID}" )

# Globals (match existing script behavior)
declare TASK
declare PERFORM_ROLLUP
declare PERFORM_APP_REP
declare PERFORM_VM_REP
declare PERFORM_ZFS_REP_ALL
declare PERFORM_ZFS_REP_LATEST
declare RUNNING_IN_BACKGROUND
declare TEST_MODE
declare STOP_RUNNING_VMS
declare EXEC_DATE="$(date +%Y-%m-%d)"
declare LOG_FILE="${LOG_DIR}/${SCRIPT_FILENAME}.$(date +"%Y-%m-%d_%H-%M").log"
declare DB_RESTORE_LOG="${LOG_DIR}/${SCRIPT_FILENAME}_DB_Restore.$(date +"%Y-%m-%d_%H-%M").log"
declare BACKUP_OPTIONS=( "$@" )

declare LOCAL_SOURCE
declare REMOTE_SOURCE
declare LOCAL_TARGET
declare REMOTE_TARGET

declare -a APP_LIST=()                        # empty means “all Apps"
declare -a VM_LIST=()                         # empty means “all VMs”

# Source modules
# shellcheck source=lib/common.bash
source "${SCRIPT_DIR}/../lib/common.bash"
# shellcheck source=lib/cli.bash
source "${SCRIPT_DIR}/../lib/cli.bash"
# shellcheck source=lib/rep_apps.bash
source "${SCRIPT_DIR}/../lib/rep_apps.bash"
# shellcheck source=lib/docker.bash
source "${SCRIPT_DIR}/../lib/docker.bash"
# shellcheck source=lib/immich_db.bash
source "${SCRIPT_DIR}/../lib/immich_db.bash"
# shellcheck source=lib/rep_filesystems.bash
source "${SCRIPT_DIR}/../lib/rep_filesystems.bash"
# shellcheck source=lib/snap_rollup.bash
source "${SCRIPT_DIR}/../lib/snap_rollup.bash"
# shellcheck source=lib/rep_vms.bash
source "${SCRIPT_DIR}/../lib/rep_vms.bash"

# Safety net: any exit that bypasses Background_error still runs the registered
# cleanups and kills the tail (see CLEANUP_COMMAND_STACK / Kill_tail in
# lib/common.bash). Background_error runs both itself (emptying the stack and
# clearing TAIL_PID), so after it this fires as a no-op. Order matters:
# cleanup output must be written while the tail is still alive to show it.
trap 'Run_cleanup; Kill_tail' EXIT

# Entry
Process_command_line_options "$@"
if [[ "$(id -un)" != "root" ]]; then
    echo "ERROR: This script can only be run as root"
    exit 1
fi

if [[ -n "${RUNNING_IN_BACKGROUND}" ]]; then
    sleep 2
    TAIL_PID="$(ps -ef | grep "tail -f ${LOG_FILE}" | grep -v grep | awk '{print $2}')"
    echo "${SCRIPT_FILENAME} is now running in the background, with parent PID ${TAIL_PID}"
    echo
    echo "######################################################################"
    echo "######################################################################"
    echo "### Performing a sync from TrueNAS-${LOCAL_SOURCE^}${REMOTE_SOURCE^} to TrueNAS-${LOCAL_TARGET^}${REMOTE_TARGET^} server ###"
    echo "######################################################################"
    echo "######################################################################"
    echo

    [[ -n "${PERFORM_APP_REP}" ]]        && Perform_app_replication
    [[ -n "${PERFORM_VM_REP}" ]]         && Perform_vm_replication
    [[ -n "${PERFORM_ZFS_REP_ALL}" ]]    && Perform_filesystem_replication all_snapshots
    [[ -n "${PERFORM_ROLLUP}" ]]         && Perform_snapshot_rollup
    [[ -n "${PERFORM_ZFS_REP_LATEST}" ]] && Perform_filesystem_replication latest_snapshot_only

    echo "################################################################################"
    echo "################################################################################"
    echo "### Sync from TrueNAS-${LOCAL_SOURCE^}${REMOTE_SOURCE^} to TrueNAS-${LOCAL_TARGET^}${REMOTE_TARGET^} server completed successfully ###"
    echo "################################################################################"
    echo "################################################################################"
    echo

    {
      echo "Subject: Sync from TrueNAS-${LOCAL_SOURCE^}${REMOTE_SOURCE^} to TrueNAS-${LOCAL_TARGET^}${REMOTE_TARGET^} server completed successfully"
      echo
      cat "${LOG_FILE}"
    } | sendmail "${EMAIL_TO}"

    # No explicit tail kill here: the 'exit 0' below fires the EXIT trap,
    # which runs Kill_tail (and the cleanup stack, empty on this path).
else
    echo "Starting ${SCRIPT_FILENAME} in the background (logfile = ${LOG_FILE})."
    nohup "$0" --running_in_background "${LOG_FILE}" "${BACKUP_OPTIONS[@]}"  >>"${LOG_FILE}" 2>&1 & { sleep 1; tail -f "${LOG_FILE}"; }
fi
exit 0
